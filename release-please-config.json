{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "separate-pull-requests": true,
  "packages": {
    "packages/acis-browser": {
      "component": "acis-browser",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='acis-browser')].version"
        }
      ]
    },
    "packages/acis-core": {
      "component": "acis-core",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='acis-core')].version"
        }
      ]
    }
  }
}
