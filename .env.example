# Shared secret required in the `x-key` header on every request.
# Generate with: openssl rand -hex 32
API_SECRET=""

##### Server #####
# HOST="127.0.0.1"
# PORT="8001"

#####  Browser #####
# CHROME_PROFILE_DIR="./profile"

# Seconds of inactivity before Chrome is torn down
# BROWSER_IDLE_TIMEOUT="900"

# Seconds to wait for one lookup attempt to produce a response.
# LOOKUP_TIMEOUT="20"
# Number of attempts to make before giving up on a lookup
# LOOKUP_ATTEMPTS="2"


##### Limits #####
# Cache TTL in seconds. Absorbs consumer retries and duplicate calls.
# CACHE_TTL="10800"

# Beyond this queue wait (seconds), return 429.
# MAX_QUEUE_WAIT="30"

###### Misc #####
# DEBUG="false"
# SENTRY_DSN=""
# SENTRY_ENV=""
