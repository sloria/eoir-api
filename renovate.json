{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allNonMajor",
    ":enablePreCommit"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["patchright"],
      "groupName": "patchright",
      "schedule": ["at any time"]
    }
  ]
}
